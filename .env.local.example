# gemini-balance-ui — local env template
# Copy to .env.local and fill in real values.

# Comma-separated Gemini API keys for the Deno proxy's LB pool.
# The Next.js /api/proxy route picks one round-robin per request and forwards
# it as `Authorization: Bearer *** to the Deno backend.
# NEVER prefix with NEXT_PUBLIC_ — these must stay server-side.
GMB_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9

# Optional: override the default Deno backend URL.
# Defaults to: https://gemini-balance-lite.appstester0919.deno.net
# GMB_BACKEND_URL=https://gemini-balance-lite.appstester0919.deno.net

# Optional: HTTP Basic Auth for the whole app (including /api/proxy)
# Leave APP_PASSWORD empty to disable auth (public access)
APP_PASSWORD=
APP_USERNAME=admin

# Optional: override the WebSocket endpoint used by /live-speaker and /listen.
# When unset, both pages connect DIRECTLY to the Deno backend:
#   wss://gemini-balance-lite.appstester0919.deno.net/ws/live    (speaker)
#   wss://gemini-balance-lite.appstester0919.deno.net/ws/listen  (listener)
# Set this ONLY for local dev (e.g. ws://localhost:8000/ws/live) or to point
# at a staging Deno deployment. NEXT_PUBLIC_ so the browser bundle sees it.
# NEXT_PUBLIC_LIVE_WS_URL=ws://localhost:8000/ws/live
